# Скопируйте в .env и заполните значения. Файл .env не коммитится (см. .gitignore).

# --- Обязательные ---

# Случайная строка >=32 символов для подписи JWT Payload.
# Сгенерировать: openssl rand -hex 32
PAYLOAD_SECRET=

# Строка подключения Postgres.
# Локальная разработка: postgres://veterany:<password>@localhost:5432/veterany
# В docker-compose собирается автоматически из POSTGRES_* ниже.
DATABASE_URI=

# Публичный URL сайта (sitemap, robots, canonical, JSON-LD).
# В Docker инлайнится при сборке — передаётся как build arg.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Только для docker-compose ---
POSTGRES_DB=veterany
POSTGRES_USER=veterany
POSTGRES_PASSWORD=
WEB_PORT=3000

# --- Необязательные ---

# Вебхук CRM: туда пересылаются заявки с форм (если задан).
CRM_WEBHOOK_URL=

# Аналитика.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Сид-скрипты (scripts/*.mjs), не нужны для работы сайта ---
SEED_PROD_URL=
SEED_EMAIL=
SEED_PASSWORD=
